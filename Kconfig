menuconfig VELVET_DISPLAY_POWER
    bool "Velvet display backlight power control"
    depends on ZMK_DISPLAY && SHIELD_PROSPECTOR_ADAPTER && !PROSPECTOR_USE_AMBIENT_LIGHT_SENSOR
    help
      Turn the Prospector backlight off when ZMK blanks the display and
      optionally enforce a minimum activity idle timeout.

if VELVET_DISPLAY_POWER

config VELVET_MIN_IDLE_TIMEOUT_MS
    int "Minimum activity idle timeout (ms, 0 = leave unchanged)"
    default 0
    range 0 3600000

endif
