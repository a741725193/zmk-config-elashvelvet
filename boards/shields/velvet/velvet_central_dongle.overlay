#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include "velvet.dtsi"
#include "split_input_common.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
    };

    mock_kscan: kscan_mock_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    tps43_listener {
        compatible = "zmk,input-listener";
        device = <&tps43_split>;
        /*
         * Studio pointer speed/rotation for the relayed trackpad. The
         * runtime processor is central-side state, so it must sit on this
         * proxy listener: the dongle has no local driver and the right half
         * has no Studio RPC. `mouse_runtime_input_processor` comes from
         * input/processors/runtime-input-processor.dtsi (0 processor cells).
         */
        input-processors = <&mouse_runtime_input_processor>;
    };
};

&kscan0 {
    status = "disabled";
};
