#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include "velvet.dtsi"
#include "split_input_common.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
    };

    mock_kscan: kscan_mock_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    tps43_listener {
        compatible = "zmk,input-listener";
        device = <&tps43_split>;
    };
};

&kscan0 {
    status = "disabled";
};

&pinctrl {
    velvet_touch_i2c0_default: velvet_touch_i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 8)>,
                    <NRF_PSEL(TWIM_SDA, 0, 12)>;
        };
    };
    velvet_touch_i2c0_sleep: velvet_touch_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 8)>,
                    <NRF_PSEL(TWIM_SDA, 0, 12)>;
            low-power-enable;
        };
    };

    velvet_als_i2c1_default: velvet_als_i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 25)>,
                    <NRF_PSEL(TWIM_SDA, 1, 8)>;
        };
    };
    velvet_als_i2c1_sleep: velvet_als_i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 25)>,
                    <NRF_PSEL(TWIM_SDA, 1, 8)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&velvet_touch_i2c0_default>;
    pinctrl-1 = <&velvet_touch_i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <100000>;

    lcd_touch: cst816s@15 {
        compatible = "hynitron,cst816s";
        reg = <0x15>;
        status = "okay";
        irq-gpios = <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        rst-gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
    };
};

&i2c1 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&velvet_als_i2c1_default>;
    pinctrl-1 = <&velvet_als_i2c1_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <100000>;

    apds9960_lcd: apds9960@39 {
        compatible = "avago,apds9960";
        reg = <0x39>;
        status = "okay";
        int-gpios = <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

&apds9960 {
    status = "disabled";
};
