if SHIELD_VELVET_RIGHT

config ZMK_KEYBOARD_NAME
    default "Velvet"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_VELVET_LEFT || SHIELD_VELVET_RIGHT

config ZMK_SPLIT
    default y

endif

# ZMK 4.1: BOARD_ENABLE_DCDC* Kconfig options are gone. Use &reg0 / &reg1
# in the board's .dts instead — see ZMK 4.1 migration guide section 11.5.3.

if ZMK_BACKLIGHT

config PWM
    default y

config LED_PWM
    default y

endif # ZMK_BACKLIGHT
